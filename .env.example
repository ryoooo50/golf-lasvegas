# ─── サーバー（Vercel Functions: api/） ────────────────────────────────
# Neon の接続文字列（Vercel の Neon 連携を使うと自動で設定される）
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Better Auth の署名用シークレット（openssl rand -base64 32 で生成）
BETTER_AUTH_SECRET=
# 本番 URL。未設定なら Vercel の本番ドメインを自動で使う
BETTER_AUTH_URL=

# ─── クライアント ──────────────────────────────────────────────────────
# ネイティブアプリ / ローカル開発で使う API の URL。Web 本番では不要（同じドメインを使う）
EXPO_PUBLIC_API_URL=https://golf-lasvegas.vercel.app
