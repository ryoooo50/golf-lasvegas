{
    "installCommand": "npm install",
    "buildCommand": "npm run build:web",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/auth?__path=$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/_expo/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
